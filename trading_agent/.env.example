# ---------------------------------------------------------------------------
# Analyst brain
# ---------------------------------------------------------------------------
# claude_code = use the Claude Code CLI with your Claude subscription (Max plan).
#               No API credits spent. Requires Claude Code installed + logged in
#               on this machine (run `claude login` once). (DEFAULT)
# api         = call the Anthropic API directly (billed per token; needs key).
BRAIN=claude_code

# Only needed if BRAIN=api:
ANTHROPIC_API_KEY=sk-ant-...

# Optional Claude Code tuning (BRAIN=claude_code):
# CLAUDE_CLI=claude              # path to the claude binary if not on PATH
# CLAUDE_CODE_MODEL=sonnet       # force a model; default uses your plan's default
# CLAUDE_CLI_TIMEOUT=120         # seconds per analysis call

# ---------------------------------------------------------------------------
# Trading configuration
# ---------------------------------------------------------------------------
# paper  = simulated fills, no real money, no broker needed (DEFAULT, recommended)
# live   = real orders. NOT implemented out of the box — see broker.py / README.
TRADING_MODE=paper

# Starting capital in INR (month 1 = 1 lakh = 100000)
CAPITAL=100000

# Which Claude model is the analyst. Trade-off: quality vs cost.
#   claude-opus-4-8   = sharpest (default)        $5/$25 per 1M tokens
#   claude-sonnet-4-6 = ~40% cheaper, very capable $3/$15
#   claude-haiku-4-5  = ~80% cheaper, fast         $1/$5
MODEL=claude-opus-4-8

# Rough USD->INR rate, only used to show the ₹ cost estimate each run.
USD_INR=83

# Aspirational monthly return target (0.10 = 10%). See README for why this is
# unrealistic/high-risk; the agent treats it as a "stop adding risk once hit"
# ceiling, not a promise.
MONTHLY_TARGET_PCT=0.10
