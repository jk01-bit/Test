# ============================================================================
# ZERODHA API CREDENTIALS (Required)
# ============================================================================
# Get these from https://developers.kite.trade/
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here

# ============================================================================
# ZERODHA AUTO-LOGIN CREDENTIALS (Required for automated login)
# ============================================================================
# Your Zerodha Kite login user ID (e.g., AB1234)
ZERODHA_USER_ID=your_user_id_here

# Your Zerodha Kite login password
ZERODHA_PASSWORD=your_password_here

# TOTP Secret Key for 2FA (Base32 encoded)
# To get this:
# 1. Go to Zerodha Console > My Profile > Security settings
# 2. Enable/Reset TOTP and scan the QR code
# 3. The secret is in the QR code URL: otpauth://totp/...?secret=YOUR_SECRET_HERE
# 4. Or use a TOTP app that shows the secret key (like Authy)
# Example: JBSWY3DPEHPK3PXP (32-character Base32 string)
ZERODHA_TOTP_SECRET=your_totp_secret_here

# ============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# ============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ============================================================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================================================
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_TO=recipient@gmail.com

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
# Trading Mode: 'paper' for simulation, 'live' for real trading
TRADING_MODE=paper

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=sqlite:///data/trading.db

# ============================================================================
# LOGGING
# ============================================================================
# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
